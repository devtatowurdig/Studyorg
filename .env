# Local Docker Compose environment.
# Dentro do Docker, o host do PostgreSQL e "postgres" porque esse e o nome do
# servico no docker-compose.yml. Use "localhost" apenas quando rodar a API fora
# dos containers.

FRONTEND_PORT=4200
API_PORT=3000
POSTGRES_PORT=5432

POSTGRES_DB=study_org
POSTGRES_USER=study_org
POSTGRES_PASSWORD=study_org

DATABASE_URL=postgresql://study_org:study_org@postgres:5432/study_org?schema=public
JWT_SECRET=change-this-secret-in-production

APP_VERSION=latest
