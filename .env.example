# Copy this file to .env at the workspace root and replace every placeholder.
# Do not commit real secrets.

# Application ports exposed on the host.
FRONTEND_PORT=3070
API_PORT=3071
POSTGRES_PORT=3072

# PostgreSQL credentials used by the postgres container.
POSTGRES_DB=<database_name>
POSTGRES_USER=<database_user>
POSTGRES_PASSWORD=<database_password>

# Backend configuration.
# Important: inside Docker, the database host is "postgres", not "localhost".
DATABASE_URL=postgresql://<database_user>:<database_password>@postgres:5432/<database_name>?schema=public
JWT_SECRET=<replace_with_a_long_random_secret>

# Image tag used by docker-compose.prod.yml.
APP_VERSION=latest
